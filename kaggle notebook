Phishing):\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>IsHTTPS</th>\n","      <th>HasPasswordField</th>\n","      <th>HasCopyrightInfo</th>\n","      <th>HasSocialNet</th>\n","    </tr>\n","    <tr>\n","      <th>IsPhishing</th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","      <th></th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>100.00</td>\n","      <td>13.85</td>\n","      <td>80.82</td>\n","      <td>79.46</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>49.22</td>\n","      <td>5.39</td>\n","      <td>5.73</td>\n","      <td>0.51</td>\n","    </tr>\n","  </tbody>\n","</table>\n","</div>"],"text/plain":["            IsHTTPS  HasPasswordField  HasCopyrightInfo  HasSocialNet\n","IsPhishing                                                           \n","0            100.00             13.85             80.82         79.46\n","1             49.22              5.39              5.73          0.51"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 1300x450 with 2 Axes>"]},"metadata":{},"output_type":"display_data"},{"data":{"image/png":"\n","text/plain":["<Figure size 1500x400 with 3 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# EXERCISE 2: Visualizing Distributions and Binary Security Indicators\n","binary_cols = ['IsHTTPS', 'HasPasswordField', 'HasCopyrightInfo', 'HasSocialNet']\n","num_cols = ['URLLength', 'CharContinuationRate', 'NoOfSelfRef']\n","\n","### START CODE HERE ### (≈ 1 line of code)\n","binary_stats =