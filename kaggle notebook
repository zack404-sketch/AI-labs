x=X_train.index)\n","X_test_scaled = pd.DataFrame(scaler.transform(X_test), columns=X.columns, index=X_test.index)\n","\n","# ---------- EXERCISE 6 ----------\n","C_values = [0.002, 0.01, 0.05, 0.1, 0.5, 1.0, 5.0]\n","active_features_count = []\n","\n","for c_val in C_values:\n","    m_l1 = LogisticRegression(penalty='l1', C=c_val, solver='liblinear',\n","                              tol=1e-2, max_iter=100, random_state=42)\n","    m_l1.fit(X_train_scaled, y_train)\n","    n_active = int(np.sum(np.abs(m_l1.coef_[0]) >= 1e-4))\n","    active_features_count.append(n_active)\n","\n","path_df = pd.DataFrame({\"C\": C_values,\n","                        \"Active_Features\": active_features_count,\n","                        \"Zeroed_Features\": [X.shape[1] - k for k in active_features_count]})\n","display(path_df)\n","\n","plt.figure(figsize=(8, 4))\n","plt.plot(C_values, active_features_count, marker='o', linewidth=2, color='#0284c7')\n","plt.xscale('log')\n","plt.xlabel(\"Inverse Regularization Strength C (log scale)\")\n","plt.ylabel(\"Number of Retained Features (|w_j| >= 1e-4)\")\n","plt.title(f\"L1 Lasso Regularization Path (Total Features = {X.shape[1]})\")\n","plt.grid(True, linestyle='--', alpha=0.6)\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"code","execution_count":10,"id":"59bdb736","metadata":{"execution":{"iopub.execute_input":"2026-11-09T18:12:11.91015Z","iopub.status.busy":"2026-11-09T18:12:11.909243Z","iopub.status.idle":"2026-11-09T18:12:11.934167Z","shell.execute_reply":"2026-11-09T18:12:11.932649Z"},"papermill":{"duration":0.034831,"end_time":"2026-11-09T18:12:11.936259+00:00","exception":false,"start_time":"2026-11-09T18:12:11.901428+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["🔴 TOP 8 FEATURES PUSHING TOWARD PHISHING (w_j > 0):\n"]},{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    