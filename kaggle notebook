    1.0   \n","2  M3: Standard L2 Ridge (C=1.0)     0.9996        0.9989    0.9992     1.0   \n","3   M4: Sparse L1 Lasso (C=0.01)     0.9993        0.9971    0.9982     1.0   \n","4    M5: SOC Weighted (balanced)     0.9995        0.9990    0.9992     1.0   \n","\n","   False Alarms (FP)  Missed Phish (FN) Zeroed Weights (Sparsity)  \n","0                 11                 25                    0 / 49  \n","1                 39                105                    0 / 49  \n","2                 10                 28                    0 / 49  \n","3                 18                 72                   24 / 49  \n","4                 13                 25                    0 / 49  "]},"metadata":{},"output_type":"display_data"}],"source":["# EXERCISE 5: Training and Comparing 5 Logistic Regression Configurations\n","configurations = {\n","    \"M1: Unregularized (None)\": LogisticRegression(penalty=None, solver='lbfgs', max_iter=500, random_state=SEED),\n","    \"M2: Strong L2 Ridge (C=0.001)\": LogisticRegression(penalty='l2', C=0.001, solver='lbfgs', max_iter=500, random_state=SEED),\n","    \"M3: Standard L2 Ridge (C=1.0)\": LogisticRegression(penalty='l2', C=1.0, solver='lbfgs', max_iter=500, random_state=SEED),\n","    \"M4: Sparse L1 Lasso (C=0.01)\": LogisticRegression(penalty='l1', C=0.01, solver='liblinear', max_iter=500, random_state=SEED),\n","    \"M5: SOC Weighted (balanced)\": LogisticRegression(penalty='l2', C=1.0, class_weight='balanced', solver='lbfgs', max_iter=500, random_state=SEED),\n","}\n","\n","results = []\n","for name, model in configurations.items():\n","    ### START CODE HERE ### (≈ 5 lines of code)\n","    model.fit(X_train_scaled, y_train)\n","    y_prob = model.predict_proba(X_test_scaled)[:, 1]\n","    y_pred = (y_prob >= 0.50).astype(int)\n","    w = model.coef_[0]\n","    n_zero_weights = int(np.sum(np.abs(w) < 1e-4))\n","    ### END CODE HERE ###\n","\n","    tn, fp, fn, tp = confusion_matrix(y_test, y_pred).ravel()\n","    results.append({\n","        \"Model\": name,\n","        \"Precision\": round(precision_score(y_test, y_pred), 4),\n","        \"Recall (TPR)\": round(recall_score(y_test, y_pred), 4),\n","        \"F1-Score\": round(f1_score(y_test, y_pred), 4),\n","        \"PR-AUC\": round(average_precision_score(y_test, y_prob), 4),\n","        \"False Alarms (FP)\": int(fp),\n","        \"Missed Phish (FN)\": int(fn),\n","        \"Zeroed Weights (Sparsity)\": f\"{n_zero_weights} / {len(w)}\"\n","    })\n","\n","results_df = pd.DataFrame(results)\n","display(results_df)"]},{"cell_type":"code","execution_count":9,"id":"965e6fab","metadata":{"execution":{"iopub.execute_input":"2026-11-09T18:12:02.638183Z","iopub.status.busy":"2026-11-09T18:12:02.637411Z","iopub.status.idle":"2026-11-09T18:12:11.892426Z","shell.execute_reply":"2026-11-09T18:12:11.891525Z"},"papermill":{"duration":9.267609,"end_time":"2026-11-09T18:12:11.894981+00:00","exception":false,"start_time":"2026-11-09T18:12:02.627372+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"text/html":["<div>\n","<style scoped>\n","    .dataframe tbody tr th:only-of-type {\n","        vertical-align: middle;\n","    }\n","\n","    .dataframe tbody tr th {\n","        vertical-align: top;\n","    }\n","\n","    .dataframe thead th {\n","        text-align: right;\n","    }\n","</style>\n","<table border=\"1\" class=\"dataframe\">\n","  <thead>\n","    <tr style=\"text-align: right;\">\n","      <th></th>\n","      <th>C</th>\n","      <th>Active_Features</th>\n","      <th>Zeroed_Features</th>\n","    </tr>\n","  </thead>\n","  <tbody>\n","    <tr>\n","      <th>0</th>\n","      <td>0.002</td>\n","      <td>22</td>\n","      <td>27</td>\n","    </tr>\n","    <tr>\n","      <th>1</th>\n","      <td>0.010</td>\n","      <td>30</td>\n","      <td>19</td>\n","    </tr>\n","    <tr>\n","      <th>2</th>\n","      <td>0.050</td>\n","      <td>45</td>\n","      <td>4</td>\n","    </tr>\n","    <tr>\n","      <th>3</th>\n","   